{
  "name": "friends-poker",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n vite,wrangler -c blue,yellow \"vite build --watch\" \"wrangler dev --port 8003 --ip 127.0.0.1\"",
    "dev:ui": "vite --port 8013 --strictPort",
    "build": "tsc -p tsconfig.client.json --noEmit && vite build",
    "check": "tsc -p tsconfig.worker.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "deploy": "npm run build && wrangler deploy",
    "types": "wrangler types"
  },
  "dependencies": {
    "lucide-react": "1.70.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261107.1",
    "@tailwindcss/vite": "4.3.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "concurrently": "9.2.1",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3",
    "vite": "8.3.6",
    "vitest": "5.1.0",
    "wrangler": "4.158.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261104.1": true
  }
}
