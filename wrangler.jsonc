{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "poker",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "alias": {
    "@shared/protocol": "./src/shared/protocol.ts",
    "@shared/flags": "./src/shared/flags.ts",
    "@engine/index": "./src/engine/index.ts",
    "@engine/cards": "./src/engine/cards.ts",
    "@engine/types": "./src/engine/types.ts",
    "@engine/variants": "./src/engine/variants.ts",
    "@engine/evaluate": "./src/engine/evaluate.ts",
    "@engine/engine": "./src/engine/engine.ts",
    "@engine/equity": "./src/engine/equity.ts",
    "@engine/hud": "./src/engine/hud.ts",
    "@engine/tournament": "./src/engine/tournament.ts"
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/ws/*"]
  },
  "durable_objects": {
    "bindings": [
      { "name": "TABLE", "class_name": "TableDO" },
      { "name": "ACCOUNTS", "class_name": "AccountsDO" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["TableDO", "AccountsDO"] }
  ],
  "vars": {
    // Comma-separated account ids (never usernames) with admin rights. Admins can also be granted through the
    // ADMIN_BOOTSTRAP_TOKEN secret (POST /api/admin/claim). Signing up never grants admin.
    "ADMIN_USER_IDS": "",
    // In-app feedback becomes GitHub issues here. Needs the GITHUB_TOKEN secret (wrangler secret put GITHUB_TOKEN).
    "FEEDBACK_REPO": "nishantroy/poker"
  },
  "observability": { "enabled": true }
}
